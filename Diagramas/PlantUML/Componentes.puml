@startuml
skinparam componentStyle uml2
top to bottom direction

package "Frontend (React SPA)" {
    component [UI Components\n(Páginas e Telas)] as ui
    component [API Client\n(Axios / Services)] as client
    ui ..> client : utiliza
}

package "Backend API (Spring Boot)" {
    component [API REST\n(Controllers Layer)] as api

    interface "REST/HTTP JSON" as rest
    api - rest : <<provided>>

    package "Domínio / Módulos de Negócio" {
        component [Autenticação] as auth
        component [Agendamentos] as agenda
        component [Clientes e Veículos] as clientes
        component [Orçamentos] as orc
        component [Ordem de Serviço] as os
        component [Estoque e Peças] as estoque
        component [Financeiro] as financeiro

        interface "IAuth" as iauth
        interface "IAgenda" as iagenda
        interface "IClientes" as iclientes
        interface "IOrcamento" as iorc
        interface "IOrdemServico" as ios
        interface "IEstoque" as iestoque
        interface "IFinanceiro" as ifinanceiro

        auth - iauth : <<provided>>
        agenda - iagenda : <<provided>>
        clientes - iclientes : <<provided>>
        orc - iorc : <<provided>>
        os - ios : <<provided>>
        estoque - iestoque : <<provided>>
        financeiro - ifinanceiro : <<provided>>

        api ..> iauth : <<required>>
        api ..> iagenda : <<required>>
        api ..> iclientes : <<required>>
        api ..> iorc : <<required>>
        api ..> ios : <<required>>
        api ..> iestoque : <<required>>
        api ..> ifinanceiro : <<required>>

        agenda ..> iclientes : <<required>>
        orc ..> iestoque : <<required>>\ncalcula peças
        os ..> iestoque : <<required>>\nBaixa estoque
        financeiro ..> ios : <<required>>\nfaturamento
    }

    interface "IPersistencia" as ipersist
    component [Camada de Persistência] as persistencia
    persistencia - ipersist : <<provided>>

    auth ..> ipersist : <<required>>
    agenda ..> ipersist : <<required>>
    clientes ..> ipersist : <<required>>
    orc ..> ipersist : <<required>>
    os ..> ipersist : <<required>>
    estoque ..> ipersist : <<required>>
    financeiro ..> ipersist : <<required>>
}

package "Persistência / ORM" {
    interface "IRepositorios" as irepo
    component [Repositórios] as repo
    interface "IJPA" as ijpa
    component [JPA / Hibernate] as jpa

    repo - irepo : <<provided>>
    jpa - ijpa : <<provided>>
    repo ..> ijpa : <<required>>
}

database "PostgreSQL DB" as db

client ..> rest : <<required>>\nHTTP/JSON
persistencia ..> irepo : <<required>>
jpa ..> db : JDBC

@enduml