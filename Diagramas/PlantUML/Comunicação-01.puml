@startuml "Comunicação - Solicitar Agendamento"

skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam monochrome false
skinparam ArrowColor #475569

actor  "cli: Cliente"                   as cli
participant "view: PortalCliente.jsx"   as view
participant "ctrl: AgendamentoController" as ctrl
participant "svc: AgendamentoService"  as svc
participant "rep: AgendamentoRepository" as rep
database "PostgreSQL" as db

cli  --> view : 1: preencherDadosAgendamento(dataHora, descricao)
view --> ctrl : 2: POST /api/agendamentos
ctrl --> svc  : 3: criarAgendamento(dto)
svc  --> rep  : 3.1: verificarDisponibilidade(dataHora)
rep  --> db   : 3.2: SELECT COUNT(*)
rep  --> svc  : 3.3: disponibilidade(false)
svc  --> rep  : 3.4: save(agendamento)
rep  --> db   : 3.5: INSERT
rep  --> svc  : 3.6: agendamentoPersistido
svc  --> ctrl : 4: agendamentoResponse
ctrl --> view : 5: HTTP 201 Created
view --> cli  : 6: exibirSucesso

@enduml