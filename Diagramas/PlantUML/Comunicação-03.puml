@startuml "Comunicação - Atualizar Ordem de Serviço"
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam monochrome false
skinparam ObjectBackgroundColor #F8FAFC
skinparam ObjectBorderColor #64748B
skinparam DatabaseBackgroundColor #FEF3C7
skinparam DatabaseBorderColor #D97706
skinparam ActorBackgroundColor #EFF6FF
skinparam ActorBorderColor #3B82F6
skinparam ArrowColor #475569

actor  "mec: Mecânico"               as mec
participant "view: AgendaDashboard.jsx"   as view
participant "ctrl: OSController"          as ctrl
participant "svc: OSService"              as svc
participant "osRep: OSRepository"         as osRep
participant "pecaRep: PecaRepository"     as pecaRep
database "PostgreSQL"                as db

mec     --> view    : 1: finalizarServico(numeroOS, pecasConsumidas)
view    --> ctrl    : 2: PUT /api/ordens-servico/{id}/finalizar
ctrl    --> svc     : 3: finalizarOS(numeroOS, pecasConsumidas)
svc     --> osRep   : 3.1: findById(numeroOS)
osRep   --> db      : 3.2: SELECT * FROM tb_ordens_servico
osRep   --> svc     : 3.3: osEntity
svc     --> pecaRep : 3.4: [para cada peça] deduzirEstoque(codigoPeca, qtd)
pecaRep --> db      : 3.5: UPDATE tb_pecas SET estoque_atual = ...
pecaRep --> svc     : 3.6: ok
svc     --> osRep   : 3.7: save(os)
osRep   --> db      : 3.8: UPDATE tb_ordens_servico
osRep   --> svc     : 3.9: osPersistida
svc     --> ctrl    : 3.10: osResponse
ctrl    --> view    : 4: HTTP 200 OK
view    --> mec     : 5: atualizarInterface
@enduml