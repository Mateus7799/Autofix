@startuml "Diagrama de Sequência - Secretário"
autonumber

skinparam actorStyle awesome
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName "Segoe UI"
skinparam BoxPadding 25
skinparam ParticipantPadding 20

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #1D4ED8
}
skinparam ArrowColor #334155
skinparam Note {
    BackgroundColor #FEF3C7
    BorderColor #F59E0B
    FontColor #92400E
}

actor "Secretário" as sec

box "Módulo de Atendimento" #F0FDF4
    participant "Agendamento & Agenda" as mod_agenda #22C55E
end box

box "Módulo de Oficina" #FFFBEB
    participant "Orçamentos & Serviços" as mod_os #F59E0B
end box

== 🗓️ Gestão Operacional da Agenda ==
sec -> mod_agenda : cadastrarCliente(dadosCliente)
activate mod_agenda
mod_agenda --> sec : clienteSalvo(201 Created)
deactivate mod_agenda

sec -> mod_agenda : gerenciarAgenda(acao, idAgendamento)
activate mod_agenda
mod_agenda --> sec : agendaAtualizada
deactivate mod_agenda

== 🚗 Entrada do Veículo na Oficina ==
sec -> mod_agenda : encaminharVeiculo(placa, idMecanico)
activate mod_agenda

mod_agenda -> mod_os : vincularMecanicoAoVeiculo(placa, idMecanico)
activate mod_os
mod_os --> mod_agenda : vinculoConfirmado
deactivate mod_os

mod_agenda --> sec : veiculoProntoParaManutencao
deactivate mod_agenda

@enduml